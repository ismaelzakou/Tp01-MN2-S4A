// ---------- Methode des trapezes ----------
function q = trapezes(t, y)
    n = length(t) - 1;
    q = 0;
    for i = 1:n
        h = t(i+1) - t(i);
        if h <= 0 then error("Temps non croissants"); end
        aire = h * (y(i) + y(i+1)) / 2;   // TODO 1 : aire du trapeze
        q = q + aire;                      // TODO 2 : on ajoute au total
    end
endfunction

// ---------- Methode de Simpson ----------
function q = simpson(t, y)
    n = length(t) - 1;
    if modulo(n, 2) <> 0 then error("Simpson exige n pair"); end   // TODO 3
    h = t(2) - t(1);
    for i = 2:n
        pas = t(i+1) - t(i);
        if abs(pas - h) > 1e-10 then error("Simpson exige des pas egaux"); end   // TODO 4
    end
    q = y(1) + y(n+1);
    for i = 2:n
        if modulo(i, 2) == 0 then
            q = q + 4 * y(i);   // TODO 5 : poids 4
        else
            q = q + 2 * y(i);   // TODO 5 : poids 2
        end
    end
    q = h / 3 * q;              // TODO 5 : facteur h/3
endfunction

