// ---------- Calcul pour la pompe ----------
tmin = [0 10 20 30 40];
Pkw = [2.0 2.6 3.0 2.5 1.9];
th = zeros(1, length(tmin));
for i = 1:length(tmin)
    th(i) = tmin(i) / 60;       // TODO 6 : minutes en heures
end
ET = trapezes(th, Pkw);
ES = simpson(th, Pkw);
ecart = abs(ET - ES);
mprintf("Trapezes : %.4f kWh\n", ET);
mprintf("Simpson : %.4f kWh\n", ES);
mprintf("Ecart : %.4f kWh\n", ecart);
mprintf("Incertitude des lectures : %.4f kWh\n", 0.1 * 40 / 60);

